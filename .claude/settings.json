{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(dotnet build:*)",
      "Bash(dotnet test:*)",
      "Bash(dotnet restore:*)",
      "Bash(dotnet format:*)",
      "Bash(dotnet list:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)"
    ],
    "ask": [
      "Bash(dotnet add package:*)",
      "Bash(dotnet ef:*)",
      "Bash(git push:*)",
      "Bash(git commit:*)",
      "Bash(git reset:*)"
    ],
    "deny": [
      "Read(./src/Harmonia.API/.env)",
      "Edit(./src/Harmonia.API/.env)",
      "Read(./**/appsettings.Production.json)",
      "Bash(git push --force:*)",
      "Bash(rm -rf:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-context.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}