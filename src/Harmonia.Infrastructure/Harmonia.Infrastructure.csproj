<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Harmonia.Application\Harmonia.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Only for ICurrentUserService, which reads claims off IHttpContextAccessor. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="brevo_csharp" Version="1.1.3" />
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="CloudinaryDotNet" Version="1.29.3" />
    <PackageReference Include="Google.Apis.Auth" Version="1.77.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="9.0.6" />
    <PackageReference Include="Microsoft.Extensions.Identity.Core" Version="9.0.9" />
    <PackageReference Include="QuestPDF" Version="2026.9.1" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.23.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- First Vietnamese names of the liturgical calendar; DataSeeder loads it into an empty table. -->
    <EmbeddedResource Include="Data\LiturgicalNameTranslations.json" LogicalName="LiturgicalNameTranslations.json" />
    <!-- First Mass types, ceremony types, Mass parts and song theme tree; DataSeeder loads each into an empty table. -->
    <EmbeddedResource Include="Data\SongCatalogs.json" LogicalName="SongCatalogs.json" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
