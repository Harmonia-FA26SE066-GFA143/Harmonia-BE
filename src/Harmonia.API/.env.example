# Copy this file to .env and fill in real values. NEVER commit .env.
# A double underscore is ASP.NET Core's nesting separator:
# Jwt__Key here is read as configuration["Jwt:Key"].

# Database
ConnectionStrings__DefaultConnection=

# JWT - Key must be at least 32 characters
Jwt__Key=
Jwt__Issuer=
Jwt__Audience=
Jwt__ExpiryMinutes=
Jwt__RefreshTokenExpiryDays=

# CORS - web and mobile origins, comma separated
Cors__AllowedOrigins=

# Cloudinary - file storage (avatars public; practice audio and music materials private)
Cloudinary__CloudName=
Cloudinary__ApiKey=
Cloudinary__ApiSecret=
Cloudinary__SignedUrlExpiryMinutes=

# Brevo - transactional email. FromEmail must be a verified sender in Brevo.
Brevo__ApiKey=
Brevo__FromEmail=
Brevo__FromName=

# Password reset - the emailed link is <url>?token=...; Web gets WebUrl, Android/iOS get MobileUrl
PasswordReset__WebUrl=
PasswordReset__MobileUrl=

# First Admin - created at startup only when no active Admin exists. Fresh databases only;
# remove the password once that Admin has signed in and changed it.
Seed__AdminEmail=
Seed__AdminPassword=

# Google Sign-In - OAuth client ids (web, Android, iOS) from Google Cloud Console, comma separated
Google__ClientIds=
