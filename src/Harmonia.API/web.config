<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <security>
      <requestFiltering>
        <!-- IIS stops anything above 30 MB before the app sees it. 101 MB fits a 100 MB skill evidence clip;
             every other endpoint keeps ASP.NET Core's 30 MB limit. Keep in step with MemberSkillsController. -->
        <requestLimits maxAllowedContentLength="105906176" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
